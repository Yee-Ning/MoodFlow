# Local Docker Compose configuration. Copy to .env and enter your own LLM key.
COMPOSE_PROJECT_NAME=moodflow
MOODFLOW_BIND=127.0.0.1
MOODFLOW_PORT=8088
LLM_API_KEY=
LLM_BASE_URL=https://your-compatible-api.example/v1
LLM_MODEL=your-model-id
LLM_GENERATION_MODEL=your-generation-model-id
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096

# Change this local-development password before sharing access to the database.
POSTGRES_PASSWORD=moodflow-local-only

# Qwen embedding weights download from Hugging Face on the first index build.
# Set HF_ENDPOINT to an accessible compatible mirror only if required.
HF_ENDPOINT=https://huggingface.co
