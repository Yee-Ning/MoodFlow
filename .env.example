# Compose interpolation only. Copy to an ignored .env.production outside version control.
COMPOSE_PROJECT_NAME=moodflow-production
IMAGE_TAG=worldline-v1-fe24b04
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8088
# Browser API URLs are intentionally same-origin (empty build args in Compose).
# Terminate HTTPS at the server edge before exposing this HTTP listener.
SESSION_COOKIE_SECURE=true

# Secret FILE PATHS only; never put credentials in this file or build arguments.
POSTGRES_PASSWORD_FILE=/secure/moodflow/postgres_password
LLM_API_KEY_FILE=/secure/moodflow/llm_api_key
QDRANT_API_KEY_FILE=/secure/moodflow/qdrant_api_key
POSTGRES_DB=moodflow_agent
POSTGRES_USER=moodflow
DATABASE_URL=postgresql://moodflow@postgres:5432/moodflow_agent
SPRING_BOOT_BASE_URL=http://java:8080
NETEASE_API_BASE_URL=http://netease:3000
QDRANT_URL=http://qdrant:6333

# Provider/model settings, preserving the frozen runtime defaults.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_GENERATION_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
SPRING_BOOT_TIMEOUT_SECONDS=10
# Only these two approved directories are mounted, not all of ai-service/data.
APPROVED_RELEASE_DIR=./deployment-artifacts/data/knowledge/releases/worldline-final-native-release-20260927/v2
APPROVED_INDEX_DIR=./deployment-artifacts/data/indexing/worldline/final-native-20260927/v4
AI_RAG_INDEX_MANIFEST=data/indexing/worldline/final-native-20260927/v4/index_build_manifest.json
# Cache provisioned from the pinned HF model revision; no first-request download.
HF_CACHE_DIR=./deployment-artifacts/huggingface
INTENT_MODEL_DIR=./deployment-artifacts/artifacts/intent_model
