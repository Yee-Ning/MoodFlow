# Non-secret overlay for the existing ai-service/.env; retain its existing
# DATABASE_URL, PGPASSFILE, provider credentials, and persistence settings.
# Requires the approved full v4 index and a healthy existing PostgreSQL volume.
CHECKPOINT_BACKEND=postgres
AI_RAG_RETRIEVAL_MODE=hybrid
AI_RAG_RERANK_MODE=off
AI_RAG_INDEX_MANIFEST=data/indexing/worldline/v4/index_build_manifest.json
LLM_MODEL=deepseek-flash
LLM_GENERATION_MODEL=deepseek-flash
SPRING_BOOT_BASE_URL=http://127.0.0.1:8080
