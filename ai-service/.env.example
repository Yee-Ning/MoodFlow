LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_GENERATION_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
SPRING_BOOT_BASE_URL=http://127.0.0.1:8080
SPRING_BOOT_TIMEOUT_SECONDS=10
AI_AGENT_GRAPH_MODE=foundation
# Session-stable 10% candidate rollout; keep closed until the replay report is approved.
HANDOFF_CANARY_ENABLED=false
HANDOFF_CANARY_PERCENTAGE=10
HANDOFF_CANARY_SALT=moodflow-handoff-v1
TYPESAFE_API_KEY=
JEV_ENABLED=false
JEV_SHADOW_MODE=true
JEV_ROUTER_ENABLED=false
JEV_MEMORY_FILTER_ENABLED=false
JEV_CONTEXT_SELECT_ENABLED=false
JEV_PROVIDER=typesafe
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
JEV_ROUTER_CONFIDENCE_THRESHOLD=0.80
# Handoff entry triage and transfer review are evaluated independently.
JEV_HANDOFF_ROUTER_ENABLED=false
JEV_HANDOFF_ROUTER_SHADOW_MODE=true
JEV_HANDOFF_GUARD_ENABLED=true
JEV_HANDOFF_GUARD_SHADOW_MODE=true
JEV_HANDOFF_GUARD_THRESHOLD=0.80
JEV_HANDOFF_INJECTION_THRESHOLD=0.20
JEV_MEMORY_FILTER_THRESHOLD=0.50
JEV_CONTEXT_SELECT_THRESHOLD=0.50
CHECKPOINT_BACKEND=memory
PERSISTENCE_BACKEND=sqlite
MEMORY_BACKEND=memory
DATABASE_URL=
PGPASSFILE=
AI_RAG_RETRIEVAL_MODE=empty
AI_RAG_RERANK_MODE=off
AI_RAG_INDEX_MANIFEST=
QDRANT_API_KEY=
MINERU_CLOUD_ENABLED=false
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_PUBLIC_DNS_FALLBACK_ENABLED=true
