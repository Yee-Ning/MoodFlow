  "approved_rewrites": {
    "rag-v0-001": {
      "ground_truth": "按新 release 中可核实的节点，杰威尔公告记载周杰伦于2000年11月6日发行首张个人创作专辑《Jay》；《叶惠美》条目记载《晴天》《东风破》在2003年HitFM年度百首单曲中分别列第2和第41。杰威尔的DEMO新闻还回忆了他在2000年前后从幕后走向幕前的过程，并称其早期DEMO完成度高、保留创作初始的画面感与哼唱旋律。这些是音乐生涯的可核实节点，不是完整年表。",
      "required_facts": [
        "杰威尔公告记载周杰伦于2000年11月6日发行首张个人创作专辑《Jay》",
        "《叶惠美》条目记载《晴天》《东风破》在2003年HitFM年度百首单曲分别列第2和第41",
        "杰威尔DEMO新闻回忆2000年前后由幕后走向幕前，并描述其早期DEMO完成度高、保留初始画面感与哼唱旋律"
      ]
    },
    "rag-v0-024": {
      "ground_truth": "以新 release 的《七里香》曲目表为例，《我的地盘》由方文山作词，《藉口》由周杰伦作词，《将军》由黄俊郎作词，《搁浅》由宋健彰作词，《困兽之斗》由刘畊宏作词。这里只列出可核实的歌曲与署名示例，不是全部作词人名单。",
      "required_facts": [
        "《七里香》曲目表的作词栏将《我的地盘》署名为方文山、《藉口》署名为周杰伦",
