[Unit]
Description=MoodFlow verified PostgreSQL and Qdrant backup
Wants=docker.service
After=docker.service
ConditionPathExists=/opt/moodflow/.env.production

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/moodflow
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/bin/bash /opt/moodflow/deploy/backup.sh
